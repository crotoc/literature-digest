# 部署参数与密钥。静态参考数据放各模块 config.yaml，用户可改的设置放 DB。
APP_ENV=dev
APP_SECRET_KEY=change-me-at-least-32-chars-long-value
DATABASE_URL=sqlite:///./data/dev.sqlite3
# DATABASE_URL=mysql+pymysql://literature_digest_app:pw@mysql/literature_digest_v2
BLOB_ROOT=./data/blobs
LOG_LEVEL=INFO
TIMEZONE=America/Chicago
ALLOW_SELF_SIGNUP=true
